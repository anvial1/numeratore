# Eliminacode: the monitor on the server's own TV output (bin/monitor-kiosk.sh in cage, user "monitor", tty1).
# Install (LAN server only): see bin/install-kiosk.sh
# Restart the screen: systemctl restart eliminacode-kiosk
[Unit]
Description=Eliminacode monitor on the TV output
After=systemd-user-sessions.service plymouth-quit-wait.service apache2.service mariadb.service
Conflicts=getty@tty1.service

[Service]
User=monitor
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
ExecStart=/usr/bin/cage -d -s -- /bin/sh /var/www/html/eliminacode/bin/monitor-kiosk.sh
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
